//LeetCode 129

class Solution {
    int sum = 0;
    public int sumNumbers(TreeNode root)     {
        sumNumbers(root, 0);
        return sum;
    }
    public void sumNumbers(TreeNode root, int num){
        if(root == null) return;
        num = (num * 10) + root.val;
        if(root.left == null && root.right == null){
            sum += num;
        }
        sumNumbers(root.left, num);
        sumNumbers(root.right, num);
        return;
    }
}
