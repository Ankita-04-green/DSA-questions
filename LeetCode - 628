//LeetCode 628

class Solution {
    public int maximumProduct(int[] nums) {
        if(nums.length == 3){
            return nums[0] * nums[1] * nums[2];
        }
        int n = nums.length;
        Arrays.sort(nums);
        int prod;
        //in case of all negative or all positive integers;
        prod = nums[n - 1] * nums[n - 2] * nums[n - 3];
        //if array contains mix elements
        int mix = nums[0] * nums[1] * nums[n - 1];
        if(mix > prod) prod = mix;
        return prod;
    }
}
