//LeetCode 17

class Solution {
    public List<String> letterCombinations(String digits) {
        HashMap<Character, String> map = new HashMap<>();
        map.put('2', "abc");
        map.put('3', "def");
        map.put('4', "ghi");
        map.put('5', "jkl");
        map.put('6', "mno");
        map.put('7', "pqrs");
        map.put('8', "tuv");
        map.put('9', "wxyz");
        ArrayList<String> result = new ArrayList<>();
        backtrack(result, new StringBuilder(), digits, map, 0);
        return result;
    }
    public void backtrack(ArrayList<String> result, StringBuilder p, String digits, HashMap<Character, String> map, int index){
        if(index == digits.length()){
            result.add(p.toString());
            return;
        }
        char digit = digits.charAt(index);
        String str = map.get(digit);
        for(int i = 0; i < str.length(); i++){
            char ch = str.charAt(i);
            backtrack(result, p.append(ch), digits, map, index + 1);
            p.deleteCharAt(p.length() - 1);
        }
    }
}
