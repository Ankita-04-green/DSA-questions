#LeetCode 226 - Invert Binary Tree

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public TreeNode invertTree(TreeNode root) {
        invertT(root);
        return root;
    }
    public void invertT(TreeNode root) {
        if(root == null) return;
        TreeNode t = root;
        TreeNode tempL = null;
        TreeNode tempR = null;
        if(t.left != null) tempR = t.left;
        if(t.right != null) tempL = t.right;
        t.left = tempL;
        t.right = tempR;
        invertTree(t.left);
        invertTree(t.right);
    }
}
