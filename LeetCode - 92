//LeetCode 92

class Solution {
    public ListNode reverseBetween(ListNode head, int left, int right) {
        if(head.next == null || left == right){
            return head;
        }
        ListNode temp = head;
        ListNode start = null;
        ListNode front = null;
        ListNode end = null;
        if(left == 1){
            start = head;
        }
        int count = 1;
        while(temp.next != null){
            count++;
            if(left == count){
                front = temp;
                start = temp.next;
            }
            if(right == count){
                end = temp.next;
                break;
            }
            temp = temp.next;
        }
        ListNode back = end.next;
        end.next = null;
        reverse(start);
        start.next = back;
        if(front != null)
            front.next = end;
        if(left == 1)
            return end;
        return head;
    }
    public void reverse(ListNode start){
        ListNode prev = null;
        ListNode curr = start;
        ListNode next = curr.next;
        while(curr != null){
            curr.next = prev;
            prev = curr;
            curr = next;
            if(next != null){
                next = next.next;
            }
        }
    }
}
