//LeetCode 974

class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        int[] arr = new int[k];
        arr[0]++;
        int prefixSum = 0;
        int rem = 0;
        int ans = 0;
        for(int i = 0; i < nums.length; i++){
            prefixSum += nums[i];
            rem = (prefixSum % k + k)  % k;
            if(arr[rem] != 0){
                ans += arr[rem];
            }
            arr[rem]++;
        }
        return ans;
    }
}
