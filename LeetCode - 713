//LeetCode 713

class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        int start = 0;
        int end = 0;
        int product = 1;
        int n = nums.length;
        int count = 0;
        while(end < n){
            product *= nums[end];
            while(start <= end && product >= k){
                product /= nums[start];
                start++;
            }
            count += end - start + 1;
            end++;
        }
        return count;
    }
}
